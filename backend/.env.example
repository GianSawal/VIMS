SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# mysql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=mysql://vims:vims_password@127.0.0.1:3306/dole_vims
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Where the React app runs (used for the TV links shown in Django admin)
FRONTEND_URL=http://localhost:5173
MEDIA_ROOT=media
# Production (see docs/SECURITY.md): nginx internal location for uploads, shared rate-limit cache, HSTS
# MEDIA_ACCEL_REDIRECT=/protected-media/
# CACHE_URL=dbcache://vrs_cache
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
FILE_UPLOAD_MAX_BYTES=5242880
LOG_LEVEL=INFO
VEHICLE_PHOTO_MAX_BYTES=5242880
ATTACHMENT_MAX_BYTES=10485760
MAINTENANCE_DUE_SOON_DAYS=30
MAINTENANCE_DUE_SOON_KM=500
# Trip map (place search + routing), server-side only; leave keys empty to disable the trip map
MAPS_PROVIDER=locationiq
LOCATIONIQ_API_KEY=
GEOAPIFY_API_KEY=
