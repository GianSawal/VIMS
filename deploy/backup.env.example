# Copy to /etc/vrs-backup.env on the Docker host (chmod 600, owner root). Used by backup.sh and restore.sh.

# MySQL container name: `docker ps --format '{{.Names}}' | grep -i mysql`. Its MYSQL_ROOT_PASSWORD is used for the dump.
MYSQL_CONTAINER=
DB_NAME=vims

# The VRS uploads volume: `docker volume ls | grep media` (Coolify prefixes it with the resource ID, e.g. abc123_media).
MEDIA_VOLUME=

# Where the encrypted backups go, and how many days to keep them there.
BACKUP_DIR=/backups/vrs
KEEP_DAYS=30

# File holding the encryption passphrase only (chmod 600). Keep a copy with the System Administrator, off this
# server: without it the backups cannot be restored.
PASSPHRASE_FILE=/root/.vrs-backup-passphrase

# Optional: copy each backup off the server. "$1" is the backup file.
# OFFSITE_CMD='rclone copy "$1" dole-backup:vrs'
OFFSITE_CMD=

# Optional: a push-monitor URL called after every successful backup (Uptime Kuma push, healthchecks.io).
HEARTBEAT_URL=
